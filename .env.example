AI_PROVIDER=openai
# Zero-key mode performs real BM25 search and returns exact source excerpts.
APP_MODE=demo
# Set APP_MODE=live after creating an embedding index. Never commit this key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-4.1-mini
RATE_LIMIT_PER_MINUTE=12
# Process-wide ceiling for live requests; resets on restart. Also set provider controls.
LIVE_REQUESTS_PER_DAY=100

